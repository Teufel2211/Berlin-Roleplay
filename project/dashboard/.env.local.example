# Kopiere diese Datei nach .env.local und fülle die Werte aus.
# NIEMALS .env.local committen (ist gitignored).

# Discord OAuth2-Anwendung (Developer Portal: https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth-Redirect-URI (muss exakt der im Developer Portal registrierten entsprechen)
# Default (local): http://localhost:3000/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Öffentliche App-URL (für Links; Default localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Projekt: hfreshlzwukfaeyveddv / https://hfreshlzwukfaeyveddv.supabase.co)
# WICHTIG: NEXT_PUBLIC_ voranstellen — env.ts liest NEXT_PUBLIC_SUPABASE_URL, nicht SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://hfreshlzwukfaeyveddv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Session-Signierung (mind. 32 Zeichen; z. B. `openssl rand -hex 32`)
SESSION_SECRET=

# Optional: Ziel-Guild für schnellen Zugriff im Dashboard (nicht erforderlich)
# DISCORD_GUILD_ID=
