# --- Discord (Pflicht) ---
DISCORD_TOKEN=
CLIENT_ID=
DISCORD_CLIENT_SECRET=          # OAuth2-Client-Secret für Dashboard-Login (identify + guilds)
OWNER_USER_ID=1370372526001356972  # Dashboard-Vollzugriff (Guild-übergreifend)

# --- Supabase (Pflicht) ---
SUPABASE_URL=https://hfreshlzwukfaeyveddv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:<passwort>@db.hfreshlzwukfaeyveddv.supabase.co:5432/postgres

# --- Website ---
WEB_PORT=3000
WEB_URL=http://localhost:3000
SESSION_SECRET=                # zufälliger String für express-session

# --- Sonstiges ---
DEBUG=0

# --- Auto-Update (KataBump) ---
# true = Bot lädt bei jedem Start neue Commits von GitHub und prüft laufend weiter.
# Nach Updates startet der Bot selbst neu (.deploy-sha merkt sich den Stand).
AUTO_UPDATE=false
AUTO_UPDATE_INTERVAL_MS=120000

# --- Hinweise ---
# OAuth-Redirect-URI im Discord Developer Portal eintragen:
#   <WEB_URL>/dashboard/auth/discord/callback
# Slash-Kommandos werden global registriert: npm run deploy
