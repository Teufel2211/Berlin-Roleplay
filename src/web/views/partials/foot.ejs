<script>
(function(){var el=document.getElementById('selfsync-badge');fetch('/api/selfsync').then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(s){if(!s||!s.enabled){return}el.hidden=false;var time=s.lastCheckAt?new Date(s.lastCheckAt).toLocaleString('de-DE'):'–';var sha=s.sha?String(s.sha).slice(0,7):'–';var text;switch(s.lastResult){case 'updated':text='Auto-Sync: '+s.lastCount+' Datei(en) aktualisiert';break;case 'installed':text='Auto-Sync: Erstinstallation ('+s.lastCount+' Dateien)';break;case 'up-to-date':text='Auto-Sync: auf neuestem Stand';break;case 'error':text='Auto-Sync: Fehler – '+ (s.lastError||'unbekannt');break;default:text='Auto-Sync: aktiv, noch kein Check';}el.textContent=' · '+text+' · Check: '+time+' · Stand: '+sha;if(s.lastFiles&&s.lastFiles.length){el.title=s.lastFiles.join('\n')}}).catch(function(){})})();
</script>
