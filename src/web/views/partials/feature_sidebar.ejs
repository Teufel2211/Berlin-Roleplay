<aside class="feature-sidebar">
  <div class="feature-nav-group">
    <div class="feature-nav-label">Server</div>
    <nav class="feature-nav">
      <% var overview = features.find(function (f) { return f.id === 'overview'; }); %>
      <% if (overview) { %>
      <a href="/dashboard/servers/<%= guildId %>/feature/overview" class="feature-link<%= activeFeature === 'overview' ? ' active' : '' %>">
        <span class="feature-icon"><%= overview.icon %></span><span><%= t('feat.overview.name', overview.name) %></span>
      </a>
      <% } %>
    </nav>
  </div>
</aside>
