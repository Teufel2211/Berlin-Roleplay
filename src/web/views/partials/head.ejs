<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'de' %>" data-theme="<%= typeof theme !== 'undefined' ? theme : 'dark' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Emergency Hamburg Roleplay</title>
  <link rel="icon" href="/img/logo.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Semi+Condensed:wght@600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <% if (locals.guildId) { %><link rel="stylesheet" href="/css/server-layout.css"><% } %>
</head>
<body>
<% if (locals.showTopbar !== false) { %>
<header class="topbar">
  <a href="/" class="brand"><img src="/img/logo.png" alt="Emergency Hamburg Roleplay" class="brand-logo">Emergency Hamburg Roleplay</a>
  <div class="topbar-right">
    <nav class="topnav">
      <a href="/" class="topnav-link<%= typeof pathName !== 'undefined' && pathName === '/' ? ' active' : '' %>"><%= t('topbar.home') %></a>
      <a href="/#systeme" class="topnav-link"><%= t('topbar.systems') %></a>
      <a href="/dashboard" class="topnav-link cta"><%= t('topbar.dashboard') %></a>
    </nav>
    <% if (locals.user) { %>
    <span class="user-chip">
      <% if (user.avatar) { %><img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="" class="user-avatar"><% } %>
      <span class="user-name"><%= user.global_name || user.username %></span>
    </span>
    <form method="post" action="/dashboard/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= locals.csrf %>">
      <button class="link-btn"><%= t('topbar.logout') %></button>
    </form>
    <% } else { %>
    <a href="/dashboard/login" class="discord-btn small"><%= t('topbar.login') %></a>
    <% } %>
  </div>
</header>
<% } %>
<main>
