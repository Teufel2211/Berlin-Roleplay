<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Emergency Hamburg Roleplay Dashboard</title>
  <link rel="icon" href="/img/logo.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <a href="/" class="brand"><img src="/img/logo.png" alt="Emergency Hamburg Roleplay" class="brand-logo">Emergency Hamburg Roleplay</a>
  <div class="topbar-right">
    <% if (locals.user) { %>
    <nav>
      <a href="/dashboard">Server wählen</a>
      <form method="post" action="/dashboard/logout" class="inline">
        <input type="hidden" name="_csrf" value="<%= locals.csrf %>">
        <button class="link-btn">Logout</button>
      </form>
    </nav>
    <span class="user-chip">
      <% if (user.avatar) { %><img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="" class="user-avatar"><% } %>
      <span class="user-name"><%= user.global_name || user.username %></span>
    </span>
    <% } else { %>
    <a href="/dashboard/login" class="discord-btn small">Login</a>
    <% } %>
  </div>
</header>
<main>

