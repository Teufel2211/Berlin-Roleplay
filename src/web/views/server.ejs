<%- include('partials/head', { title, user, csrf, guildId, lang, t, theme }) %>
<section class="server-page">
  <header class="server-head">
    <div class="server-head-main">
      <div class="server-icon">
        <% if (activeGuild.icon) { %>
        <img src="https://cdn.discordapp.com/icons/<%= activeGuild.id %>/<%= activeGuild.icon %>.png?size=128" alt="" onerror="this.parentElement.textContent='<%= activeGuild.name.charAt(0) %>'">
        <% } else { %><span class="guild-fallback"><%= activeGuild.name.charAt(0) %></span><% } %>
      </div>
      <div class="server-head-text"><h1 class="server-name"><%= activeGuild.name %></h1><span class="server-id">Server-ID: <%= activeGuild.id %></span></div>
    </div>
    <a href="/dashboard" class="btn subtle"><%= t('topbar.switchServer') %></a>
  </header>
  <div class="server-body">
    <%- include('partials/feature_sidebar', { features, activeFeature, guildId, t }) %>
    <div class="feature-content<%= data.sections && data.sections.length > 1 ? ' has-subnav' : '' %>">
      <%- include('partials/_subnav', { sections: data.sections, t }) %>
      <% if (data.discordOk === false && feature.id !== 'overview' && feature.id !== 'audit') { %>
      <div class="alert warn"><%= t('common.botOffline') %></div>
      <% } %>
      <% if (feature.id === 'overview') { %>
        <%- include('features/_overview', { data, guildId, csrf, t }) %>
      <% } else if (feature.id === 'verification') { %>
        <%- include('features/_verification', { data }) %>
      <% } else if (feature.id === 'warteraum') { %>
        <%- include('features/_settings_only', { data, featureId: 'warteraum', guildId }) %>
      <% } else if (feature.id === 'tickets') { %>
        <%- include('features/_tickets', { data, guildId, csrf }) %>
      <% } else if (feature.id === 'bewerbung') { %>
        <%- include('features/_bewerbung', { data, guildId }) %>
      <% } else if (feature.id === 'giveaway') { %>
        <%- include('features/_giveaway', { data, guildId }) %>
      <% } else if (feature.id === 'interview') { %>
        <% if (data.detail) { %><%- include('features/_interview_detail', { data, guildId }) %><% } else { %><%- include('features/_interview', { data, guildId }) %><% } %>
      <% } else if (feature.id === 'embeds') { %>
        <%- include('features/_embeds', { data, guildId }) %>
      <% } else if (feature.id === 'audit') { %>
        <%- include('features/_audit', { data, guildId }) %>
      <% } else if (['team','moderation','security','welcome'].includes(feature.id)) { %>
        <%- include('features/_management', { data, guildId, feature, csrf }) %>
      <% } %>
    </div>
  </div>
</section>
<script>
(function () {
  var nav = document.getElementById('subnav');
  if (!nav) return;

  function ticketSections() {
    if (window.location.pathname.indexOf('/feature/tickets') === -1) return;
    var ticketMap = {
      'Übersicht': 'liste',
      'Verhalten / Allgemein': 'verhalten',
      'Kategorien': 'typen',
      'Ticket-Fragen': 'fragen',
      'Panel': 'panel',
      'Prioritäten': 'prioritaeten',
      'Tags': 'tags',
      'Tickets': 'tickets',
      'Transcripts': 'transcripts',
      'Ticket-Log': 'protokoll'
    };

    Array.prototype.slice.call(document.querySelectorAll('#ticket-app .settings-group')).forEach(function (card) {
      var heading = card.querySelector('.settings-subgroup');
      var label = heading ? heading.textContent.trim() : '';
      var id = ticketMap[label];
      if (!id) return;
      card.classList.add('feature-section');
      card.id = 'sec-' + id;
    });

    var existingTargets = {};
    Array.prototype.slice.call(nav.querySelectorAll('.subnav-btn')).forEach(function (button) {
      existingTargets[button.dataset.target] = true;
    });
    [
      ['sec-fragen', 'Ticket-Fragen'],
      ['sec-panel', 'Panel'],
      ['sec-prioritaeten', 'Prioritäten'],
      ['sec-tags', 'Tags'],
      ['sec-tickets', 'Tickets'],
      ['sec-transcripts', 'Transcripts'],
      ['sec-protokoll', 'Ticket-Log']
    ].forEach(function (item) {
      if (existingTargets[item[0]]) return;
      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'subnav-btn';
      button.dataset.target = item[0];
      button.textContent = item[1];
      nav.appendChild(button);
    });

    var rename = {
      'sec-liste': 'Offene Tickets',
      'sec-typen': 'Kategorien',
      'sec-verhalten': 'Verhalten'
    };
    Array.prototype.slice.call(nav.querySelectorAll('.subnav-btn')).forEach(function (button) {
      if (rename[button.dataset.target]) button.textContent = rename[button.dataset.target];
    });
  }

  function show(id) {
    var sections = Array.prototype.slice.call(document.querySelectorAll('.feature-section'));
    sections.forEach(function (s) {
      var active = s.id === id;
      s.classList.toggle('active', active);
      s.style.display = active ? '' : 'none';
    });
    Array.prototype.slice.call(nav.querySelectorAll('.subnav-btn')).forEach(function (b) {
      b.classList.toggle('active', b.dataset.target === id);
    });
  }

  function init() {
    ticketSections();
    var first = nav.querySelector('.subnav-btn.active') || nav.querySelector('.subnav-btn');
    if (first) show(first.dataset.target);
    return Boolean(document.querySelector('#ticket-app .feature-section'));
  }

  nav.addEventListener('click', function (e) {
    var btn = e.target.closest ? e.target.closest('.subnav-btn') : null;
    if (btn) show(btn.dataset.target);
  });

  document.addEventListener('ticket-dashboard-rendered', function () {
    ticketSections();
    var active = nav.querySelector('.subnav-btn.active') || nav.querySelector('.subnav-btn');
    if (active) show(active.dataset.target);
  });

  var ticketApp = document.getElementById('ticket-app');
  if (ticketApp && typeof MutationObserver !== 'undefined') {
    var observer = new MutationObserver(function () {
      ticketSections();
      var active = nav.querySelector('.subnav-btn.active') || nav.querySelector('.subnav-btn');
      if (active) show(active.dataset.target);
    });
    observer.observe(ticketApp, { childList: true, subtree: true });
  }

  init();
})();
</script>
<%- include('partials/foot') %>
