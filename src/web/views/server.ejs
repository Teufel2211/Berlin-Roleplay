<%- include('partials/head', { title, user, csrf, guildId, lang, t, theme }) %>
<section class="server-page">
  <header class="server-head">
    <div class="server-head-main">
      <div class="server-icon">
        <% if (activeGuild.icon) { %>
        <img src="https://cdn.discordapp.com/icons/<%= activeGuild.id %>/<%= activeGuild.icon %>.png?size=128" alt="" onerror="this.parentElement.textContent='<%= activeGuild.name.charAt(0) %>'">
        <% } else { %><span class="guild-fallback"><%= activeGuild.name.charAt(0) %></span><% } %>
      </div>
      <div class="server-head-text"><h1 class="server-name"><%= activeGuild.name %></h1><span class="server-id">Server-ID: <%= activeGuild.id %></span></div>
    </div>
    <a href="/dashboard" class="btn subtle"><%= t('topbar.switchServer') %></a>
  </header>
  <div class="server-body">
    <%- include('partials/feature_sidebar', { features, activeFeature, guildId, t }) %>
    <div class="feature-content<%= data.sections && data.sections.length > 1 ? ' has-subnav' : '' %>">
      <%- include('partials/_subnav', { sections: data.sections, t }) %>
      <% if (data.discordOk === false && feature.id !== 'overview' && feature.id !== 'audit') { %>
      <div class="alert warn"><%= t('common.botOffline') %></div>
      <% } %>
      <% if (feature.id === 'overview') { %>
        <%- include('features/_overview', { data, guildId, csrf, t }) %>
      <% } else if (feature.id === 'verification') { %>
        <%- include('features/_verification', { data }) %>
      <% } else if (feature.id === 'warteraum') { %>
        <%- include('features/_settings_only', { data, featureId: 'warteraum', guildId }) %>
      <% } else if (feature.id === 'tickets') { %>
        <%- include('features/_tickets', { data, guildId }) %>
      <% } else if (feature.id === 'bewerbung') { %>
        <%- include('features/_bewerbung', { data, guildId }) %>
      <% } else if (feature.id === 'giveaway') { %>
        <%- include('features/_giveaway', { data, guildId }) %>
      <% } else if (feature.id === 'interview') { %>
        <% if (data.detail) { %><%- include('features/_interview_detail', { data, guildId }) %><% } else { %><%- include('features/_interview', { data, guildId }) %><% } %>
      <% } else if (feature.id === 'embeds') { %>
        <%- include('features/_embeds', { data, guildId }) %>
      <% } else if (feature.id === 'audit') { %>
        <%- include('features/_audit', { data, guildId }) %>
      <% } else if (['team','moderation','security','welcome'].includes(feature.id)) { %>
        <%- include('features/_management', { data, guildId, feature, csrf }) %>
      <% } %>
    </div>
  </div>
</section>
<script>
(function () {
  var nav = document.getElementById('subnav');
  if (!nav) return;
  var sections = Array.prototype.slice.call(document.querySelectorAll('.feature-section'));
  function show(id) {
    sections.forEach(function (s) { s.classList.toggle('active', s.id === id); });
    Array.prototype.slice.call(nav.querySelectorAll('.subnav-btn')).forEach(function (b) { b.classList.toggle('active', b.dataset.target === id); });
  }
  nav.addEventListener('click', function (e) {
    var btn = e.target.closest ? e.target.closest('.subnav-btn') : null;
    if (btn) show(btn.dataset.target);
  });
  var first = nav.querySelector('.subnav-btn');
  if (first) show(first.dataset.target);
})();
</script>
<%- include('partials/foot') %>
