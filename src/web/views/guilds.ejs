<%- include('partials/head', { title, user, csrf }) %>

<% if (user && user.isOwner) { %>
<section class="page owner-shell">
  <div class="owner-hero">
    <div class="owner-kicker">Global Bot Owner</div>
    <h1>Owner Dashboard</h1>
    <p>Vollzugriff auf alle Discord-Server, auf denen der Bot installiert ist.</p>
    <div class="owner-stats">
      <div class="owner-stat">
        <strong id="owner-server-count"><%= guilds.length %></strong>
        <span>Bot-Server</span>
      </div>
      <div class="owner-stat">
        <strong>Vollzugriff</strong>
        <span>Servereinstellungen</span>
      </div>
      <div class="owner-stat">
        <strong>Live</strong>
        <span>Serverliste synchronisiert</span>
      </div>
    </div>
  </div>

  <div class="owner-toolbar">
    <input id="owner-server-search" class="owner-search" type="search" placeholder="Server suchen…" autocomplete="off">
    <span class="muted" id="owner-refresh-status">Wird automatisch aktualisiert.</span>
  </div>

  <div class="guild-grid owner-grid" id="owner-guild-grid">
    <% guilds.forEach(function (g) { %>
    <div class="guild-card has-bot owner-card" data-server-name="<%= g.name.toLowerCase() %>">
      <a href="/dashboard/servers/<%= g.id %>" class="guild-card-link">
        <div class="guild-icon">
          <% if (g.icon) { %>
          <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=128" alt="" onerror="this.parentElement.textContent='<%= g.name.charAt(0) %>'">
          <% } else { %><span class="guild-fallback"><%= g.name.charAt(0) %></span><% } %>
        </div>
        <div class="guild-name"><%= g.name %></div>
        <div class="guild-meta">Bot installiert · Owner-Zugriff</div>
        <div class="owner-badge">⚙️ Einstellungen verwalten</div>
      </a>
    </div>
    <% }) %>
  </div>

  <% if (!guilds.length) { %>
  <div class="empty-state">
    <p>Der Bot ist aktuell auf keinem Server installiert.</p>
  </div>
  <% } %>
</section>

<script>
(() => {
  const search = document.getElementById('owner-server-search');
  const status = document.getElementById('owner-refresh-status');
  const count = document.getElementById('owner-server-count');

  function filter() {
    const term = (search?.value || '').trim().toLowerCase();
    const cards = Array.from(document.querySelectorAll('.owner-card'));
    let visible = 0;
    cards.forEach((card) => {
      const match = !term || (card.dataset.serverName || '').includes(term);
      card.style.display = match ? '' : 'none';
      if (match) visible += 1;
    });
    if (count) count.textContent = term ? `${visible} / ${cards.length}` : String(cards.length);
  }

  search?.addEventListener('input', filter);

  async function refresh() {
    try {
      status.textContent = 'Serverliste wird aktualisiert…';
      const response = await fetch('/dashboard', { headers: { 'X-Owner-Refresh': '1' }, cache: 'no-store' });
      if (!response.ok) throw new Error('refresh failed');
      const html = await response.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const nextGrid = doc.getElementById('owner-guild-grid');
      const nextCount = doc.getElementById('owner-server-count');
      const currentGrid = document.getElementById('owner-guild-grid');
      if (nextGrid && currentGrid) currentGrid.innerHTML = nextGrid.innerHTML;
      if (nextCount && count) count.textContent = nextCount.textContent;
      status.textContent = 'Zuletzt aktualisiert: ' + new Date().toLocaleTimeString('de-DE');
      filter();
    } catch {
      status.textContent = 'Aktualisierung fehlgeschlagen.';
    }
  }

  setInterval(refresh, 30000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refresh();
  });
})();
</script>

<% } else { %>
<section class="page">
  <div class="page-head">
    <div>
      <h1>Server wählen</h1>
      <p class="muted" id="guild-sync-status">Serverliste wird automatisch mit Discord synchronisiert.</p>
    </div>
  </div>
  <% if (!guilds.length) { %>
  <div class="empty-state">
    <p>Du verwaltest aktuell keinen Server. Lade den Bot in deinen Server ein und verwalte ihn dann hier.</p>
    <a href="<%= inviteUrl %>" class="discord-btn" target="_blank" rel="noopener">Bot einladen</a>
  </div>
  <% } else { %>
  <div class="guild-grid">
    <% guilds.forEach(function (g) { %>
    <div class="guild-card<%= g.botIn ? ' has-bot' : '' %>">
      <% if (g.botIn) { %><a href="/dashboard/servers/<%= g.id %>" class="guild-card-link"><% } %>
      <div class="guild-icon">
        <% if (g.icon) { %>
        <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=128" alt="" onerror="this.parentElement.textContent='<%= g.name.charAt(0) %>'">
        <% } else { %><span class="guild-fallback"><%= g.name.charAt(0) %></span><% } %>
      </div>
      <div class="guild-name"><%= g.name %></div>
      <div class="guild-meta"><%= g.botIn ? (g.botOnline ? 'Bot online' : 'Bot offline') : 'Bot nicht eingeladen' %></div>
      <% if (g.botIn) { %></a><% } %>
      <% if (!g.botIn) { %>
      <a href="<%= inviteUrl %>" class="btn invite-btn" target="_blank" rel="noopener">Bot hinzufügen</a>
      <% } %>
    </div>
    <% }) %>
  </div>
  <% } %>
</section>
<script>
  (() => {
    const status = document.getElementById('guild-sync-status');
    let reloading = false;
    const refresh = () => {
      if (reloading || document.visibilityState !== 'visible') return;
      reloading = true;
      if (status) status.textContent = 'Serverliste wird aktualisiert …';
      window.location.reload();
    };
    setInterval(refresh, 30000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') refresh();
    });
  })();
</script>
<% } %>

<%- include('partials/foot') %>
