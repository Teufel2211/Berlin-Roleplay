<%- include('partials/head', { title, user, csrf, lang, t, showTopbar: false }) %>

<% if (user && user.isOwner) { %>
<section class="page owner-shell">
  <div class="owner-hero">
    <div class="owner-kicker"><%= t('guilds.ownerKicker') %></div>
    <h1><%= t('guilds.ownerTitle') %></h1>
    <p><%= t('guilds.ownerDesc') %></p>
    <div class="owner-stats">
      <div class="owner-stat">
        <strong id="owner-server-count"><%= guilds.length %></strong>
        <span><%= t('guilds.botServers') %></span>
      </div>
      <div class="owner-stat">
        <strong><%= t('guilds.fullAccess') %></strong>
        <span><%= t('guilds.serverSettings') %></span>
      </div>
      <div class="owner-stat">
        <strong><%= t('guilds.live') %></strong>
        <span><%= t('guilds.listSynced') %></span>
      </div>
    </div>
  </div>

  <div class="owner-toolbar">
    <input id="owner-server-search" class="owner-search" type="search" placeholder="<%= t('guilds.search') %>" autocomplete="off">
    <span class="muted" id="owner-refresh-status"><%= t('guilds.autoRefresh') %></span>
  </div>

  <div class="guild-grid owner-grid" id="owner-guild-grid">
    <% guilds.forEach(function (g) { %>
    <div class="guild-card has-bot owner-card" data-server-name="<%= g.name.toLowerCase() %>">
      <a href="/dashboard/servers/<%= g.id %>" class="guild-card-link">
        <div class="guild-icon">
          <% if (g.icon) { %>
          <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=128" alt="" onerror="this.parentElement.textContent='<%= g.name.charAt(0) %>'">
          <% } else { %><span class="guild-fallback"><%= g.name.charAt(0) %></span><% } %>
        </div>
        <div class="guild-name"><%= g.name %></div>
        <div class="guild-meta"><%= t('guilds.installed') %></div>
        <div class="owner-badge"><%= t('guilds.manageSettings') %></div>
      </a>
    </div>
    <% }) %>
  </div>

  <% if (!guilds.length) { %>
  <div class="empty-state">
    <p><%= t('guilds.noBots') %></p>
  </div>
  <% } %>
</section>

<script>
(() => {
  const search = document.getElementById('owner-server-search');
  const status = document.getElementById('owner-refresh-status');
  const count = document.getElementById('owner-server-count');

  function filter() {
    const term = (search?.value || '').trim().toLowerCase();
    const cards = Array.from(document.querySelectorAll('.owner-card'));
    let visible = 0;
    cards.forEach((card) => {
      const match = !term || (card.dataset.serverName || '').includes(term);
      card.style.display = match ? '' : 'none';
      if (match) visible += 1;
    });
    if (count) count.textContent = term ? `${visible} / ${cards.length}` : String(cards.length);
  }

  search?.addEventListener('input', filter);

  async function refresh() {
    try {
      status.textContent = '<%= t('guilds.refreshing') %>';
      const response = await fetch('/dashboard', { headers: { 'X-Owner-Refresh': '1' }, cache: 'no-store' });
      if (!response.ok) throw new Error('refresh failed');
      const html = await response.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const nextGrid = doc.getElementById('owner-guild-grid');
      const nextCount = doc.getElementById('owner-server-count');
      const currentGrid = document.getElementById('owner-guild-grid');
      if (nextGrid && currentGrid) currentGrid.innerHTML = nextGrid.innerHTML;
      if (nextCount && count) count.textContent = nextCount.textContent;
      status.textContent = '<%= t('guilds.lastUpdated') %>' + new Date().toLocaleTimeString('de-DE');
      filter();
    } catch {
      status.textContent = '<%= t('guilds.refreshFailed') %>';
    }
  }

  setInterval(refresh, 30000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refresh();
  });
})();
</script>

<% } else { %>
<section class="page">
  <div class="page-head">
    <div>
      <h1><%= t('guilds.title') %></h1>
      <p class="muted" id="guild-sync-status"><%= t('guilds.syncStatus') %></p>
    </div>
  </div>
  <% if (!guilds.length) { %>
  <div class="empty-state">
    <p><%= t('guilds.empty') %></p>
    <a href="<%= inviteUrl %>" class="discord-btn" target="_blank" rel="noopener"><%= t('guilds.invite') %></a>
  </div>
  <% } else { %>
  <div class="guild-grid">
    <% guilds.forEach(function (g) { %>
    <div class="guild-card<%= g.botIn ? ' has-bot' : '' %>">
      <% if (g.botIn) { %><a href="/dashboard/servers/<%= g.id %>" class="guild-card-link"><% } %>
      <div class="guild-icon">
        <% if (g.icon) { %>
        <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=128" alt="" onerror="this.parentElement.textContent='<%= g.name.charAt(0) %>'">
        <% } else { %><span class="guild-fallback"><%= g.name.charAt(0) %></span><% } %>
      </div>
      <div class="guild-name"><%= g.name %></div>
      <% if (!g.botIn) { %>
      <a href="<%= inviteUrl %>" class="btn invite-btn" target="_blank" rel="noopener"><%= t('guilds.add') %></a>
      <% } %>
    </div>
    <% }) %>
  </div>
  <% } %>
</section>
<script>
  (() => {
    const status = document.getElementById('guild-sync-status');
    let reloading = false;
    const refresh = () => {
      if (reloading || document.visibilityState !== 'visible') return;
      reloading = true;
      if (status) status.textContent = '<%= t('guilds.syncing') %>';
      window.location.reload();
    };
    setInterval(refresh, 30000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') refresh();
    });
  })();
</script>
<% } %>

<%- include('partials/foot') %>
