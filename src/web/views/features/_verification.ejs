<h2 class="feature-title">Verifizierung</h2>
<p class="muted">Nutzer verifizieren sich über das Panel. Konfiguriere Kanäle, Rollen und Verhalten.</p>
<%- include('_settings_form', { data, featureId: 'verification', guildId }) %>
<% if (data.records.length) { %>
<h3 class="list-title">Verifizierte Nutzer</h3>
<div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>Nutzer</th><th>Verifiziert am</th></tr></thead>
    <tbody>
      <% data.records.forEach(function (u) { %>
      <tr><td><%= u.discord_tag || u.discord_id %></td><td><%= u.verified_at ? new Date(u.verified_at).toLocaleString('de-DE') : '—' %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
