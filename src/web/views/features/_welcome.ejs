<h2 class="feature-title">Willkommen</h2>
<% if (data.flash) { %><div class="alert"><%= data.flash %></div><% } %>
<p class="muted">Begrüßt neue Mitglieder automatisch im konfigurierten Kanal und vergibt optional eine Rolle. Platzhalter im Text: <code>{user}</code> = Erwähnung des Mitglieds, <code>{server}</code> = Servername.</p>
<%- include('../partials/_sec_settings', { sectionId: 'kanal', data, featureId, guildId }) %>
<%- include('../partials/_sec_settings', { sectionId: 'rolle', data, featureId, guildId }) %>
<%- include('../partials/_sec_settings', { sectionId: 'text', data, featureId, guildId, wrap: false }) %>
<div class="feature-section" id="sec-text">
  <h3 class="list-title">Live-Vorschau</h3>
  <div class="embed-preview" id="welcomePreview"><div class="ep-bar"></div><div class="ep-content"><div class="ep-title">Willkommen</div><div class="ep-desc">…</div><div class="ep-footer"><%- activeGuild ? activeGuild.name : 'Emergency Hamburg Roleplay' %> • Heute</div></div></div>
  <p class="muted">So sieht die Nachricht für neue Mitglieder aus. <code>{user}</code> wird im Chat als Erwähnung angezeigt.</p>
</div>
<script>
(function () {
  var ta = document.querySelector('textarea[name="settings[welcome_message]"]');
  var preview = document.getElementById('welcomePreview');
  if (!ta || !preview) return;
  function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
  function serverName() {
    var el = document.querySelector('.server-name');
    return el ? el.textContent.trim() : 'Emergency Hamburg Roleplay';
  }
  function render() {
    var msg = esc(ta.value || '').replace(/\{user\}/g, '<strong>Neues Mitglied</strong>').replace(/\{server\}/g, esc(serverName())).replace(/\n/g, '<br>');
    preview.innerHTML = '<div class="ep-bar"></div><div class="ep-content"><div class="ep-title">Willkommen</div><div class="ep-desc">' + msg + '</div><div class="ep-footer">' + esc(serverName()) + ' • Heute</div></div>';
  }
  ta.addEventListener('input', render);
  render();
})();
</script>