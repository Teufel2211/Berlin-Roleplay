<h2 class="feature-title">Übersicht</h2>
<% if (data.dbError) { %><div class="alert error"><%= data.dbError %></div><% } %>
<div class="feature-section" id="sec-uebersicht">
  <div class="stat-grid">
    <div class="stat-card"><div class="stat-value"><%= data.stats.tickets %></div><div class="stat-label">Offene Tickets</div></div>
    <div class="stat-card"><div class="stat-value"><%= data.stats.applications %></div><div class="stat-label">Offene Bewerbungen</div></div>
    <div class="stat-card"><div class="stat-value"><%= data.stats.giveaways %></div><div class="stat-label">Aktive Giveaways</div></div>
    <div class="stat-card"><div class="stat-value"><%= data.stats.team %></div><div class="stat-label">Teammitglieder</div></div>
  </div>
  <div class="bot-status">
    <span class="status-dot <%= data.botInstalled ? 'online' : 'offline' %>"></span>
    Bot <%= data.botInstalled ? 'ist auf diesem Server installiert' : 'ist nicht auf diesem Server' %>
  </div>
</div>
