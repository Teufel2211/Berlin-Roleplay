<h2 class="feature-title">🎫 Ticket-System</h2>
<p class="muted">Zentrale Verwaltung für Tickets, Kategorien, Panel, Transcripts und Statistiken · <span style="color:#3ba55c">● Live</span> <span class="muted">(Aktualisierung alle 10 Sekunden)</span></p>
<div id="ticket-app"><div class="empty-state"><p>Ticket-Daten werden geladen …</p></div></div>
<script>
(() => {
  const root=document.getElementById('ticket-app');
  const csrf=<%- JSON.stringify(typeof csrf !== 'undefined' ? csrf : '') %>;
  const guildId=<%- JSON.stringify(guildId) %>;
  const channels=<%- JSON.stringify(data.channelOptions || []) %>;
  const roles=<%- JSON.stringify(data.roleOptions || []) %>;
  const catChannels=channels.filter(c=>c.type===4);
  const textChannels=channels.filter(c=>c.type===0);
  const api=`/api/settings?guild=${encodeURIComponent(guildId)}&ticket=1`;
  async function load(query=''){const r=await fetch(api+query,{headers:{Accept:'application/json'}});if(!r.ok)throw new Error('API '+r.status);return r.json();}
  async function save(ticketAction,ticket){const r=await fetch('/api/settings?guild='+encodeURIComponent(guildId),{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify({ticketAction,ticket})});const j=await r.json().catch(()=>null);if(!r.ok||!(j&&j.ok))throw new Error(j&&j.error?j.error:('Speichern fehlgeschlagen ('+r.status+')'));return j;}
  let busy=false;const guard=async fn=>{if(busy)return;busy=true;try{await fn();}catch(err){alert(err.message||'Aktion fehlgeschlagen');}finally{busy=false;}};
  const esc=s=>String(s??'').replace(/[&<>\\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\':'&#92;','"':'&quot;'}[c]));
  const card=(title,body,id)=>`<section class="settings-group"${id?` id="${id}"`:''}><h3 class="settings-subgroup">${title}</h3>${body}</section>`;
  const field=(label,name,value='',type='text')=>`<label class="field"><span class="field-label">${label}</span><input type="${type}" name="${name}" value="${esc(value)}"></label>`;
  const sel=(label,name,options,value='',empty='')=>`<label class="field"><span class="field-label">${label}</span><select name="${name}">${empty?`<option value="">${esc(empty)}</option>`:''}${options.map(o=>`<option value="${esc(o.id)}"${String(o.id)===String(value)?' selected':''}>${esc(o.name)}</option>`).join('')}</select></label>`;
  const selMulti=(label,name,options,values=[])=>`<label class="field"><span class="field-label">${label}</span><select name="${name}" multiple size="5">${options.map(o=>`<option value="${esc(o.id)}"${values.includes(String(o.id))?' selected':''}>${esc(o.name)}</option>`).join('')}</select></label>`;
  const hexColor=n=>{const v=Math.max(0,Math.min(0xffffff,Number(n)||5793266));return '#'+v.toString(16).padStart(6,'0');};
  let lastPanel=null;
  function updatePreview(){
    const f=document.getElementById('panel-form');
    if(!f||!document.getElementById('dc-container'))return;
    const v=k=>{const el=f.elements[k];return el?String(el.value||''):'';};
    const p=lastPanel||{};
    const title=v('title')||p.title||'🎫 Support';
    const desc=v('description')||p.description||'Wähle eine Kategorie, um ein Ticket zu erstellen.';
    const footer=v('footer')||p.footer||'Emergency Hamburg Roleplay';
    const thumb=v('thumbnail')||p.thumbnail||'';
    const banner=v('banner')||p.banner||'';
    let inner=`<div class="dc-section"><div class="dc-texts"><h4 class="dc-h">${esc(title)}</h4><p class="dc-desc">${esc(desc)}</p></div>${thumb?`<img class="dc-thumb" src="${esc(thumb)}" alt="" onerror="this.style.display='none'">`:''}</div>`;
    if(banner)inner+=`<img class="dc-banner" src="${esc(banner)}" alt="" onerror="this.style.display='none'">`;
    inner+='<hr class="dc-sep"><div class="dc-select"><span>Ticket-Kategorie auswählen</span><span class="dc-caret">▾</span></div>';
    inner+=`<hr class="dc-sep"><div class="dc-subtext">${esc(footer)}</div>`;
    const box=document.getElementById('dc-container');
    box.style.setProperty('--dc-accent',hexColor(v('color')||p.color));
    box.innerHTML=inner;
  }
  function render(d){
    const s=d.settings||{}, st=d.stats||{};
    const chName=id=>{if(!id)return '—';const c=channels.find(x=>x.id===String(id));return c?c.name:String(id);};
    const metrics=[['Offen',st.open||0],['Geschlossen',st.closed||0],['Heute',st.today||0],['Diese Woche',st.week||0],['Dieser Monat',st.month||0]];
    let html=overviewHtml(d);
    const catFields=[['Name','name','','text'],['Beschreibung','description','','text'],['Emoji','emoji','🎫'],['Ticket-Limit','ticket_limit','1','number'],['Präfix','prefix','ticket'],['Farbe (Integer)','color','5793266','number']];
    const catSelects=[['Discord Kategorie-Channel','category_channel_id',catChannels,'','— Kein Channel —'],['Support-Rollen','support_role_ids',roles],['Admin-Rollen','admin_role_ids',roles],['Ping-Rollen','ping_role_ids',roles]];
    const catFormFields=catFields.map(f=>field(...f)).join('')+catSelects.map(s=>s.length===3?selMulti(...s):sel(...s)).join('');
    html+=card('Kategorien',`<form id="cat-form" class="settings-form" data-editing=""><input type="hidden" name="cat_id"><div class="settings-fields">${catFormFields}</div><div style="display:flex;gap:8px;align-items:center"><button class="btn primary" id="cat-submit-btn">Kategorie hinzufügen</button><button type="button" class="btn" id="cat-cancel-btn" style="display:none">Abbrechen</button></div></form><div class="table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>Channel</th><th>Limit</th><th>Präfix</th><th></th></tr></thead><tbody>${(d.categories||[]).map(c=>`<tr><td>${esc(c.emoji)} ${esc(c.name)}</td><td>${esc(chName(c.category_channel_id))}</td><td>${c.ticket_limit}</td><td>${esc(c.prefix||s.prefix)}</td><td style="white-space:nowrap"><button class="btn small" data-edit-cat='${esc(JSON.stringify({id:c.id,name:c.name||'',description:c.description||'',emoji:c.emoji||'',ticket_limit:c.ticket_limit??1,prefix:c.prefix||'',color:c.color||5793266,category_channel_id:c.category_channel_id||'',support_role_ids:JSON.stringify(c.support_role_ids||[]),admin_role_ids:JSON.stringify(c.admin_role_ids||[]),ping_role_ids:JSON.stringify(c.ping_role_ids||[])}))}'>Bearbeiten</button> <button class="btn small danger" data-del-cat="${c.id}">Löschen</button></td></tr>`).join('')||'<tr><td colspan="5">Keine Kategorien</td></tr>'}</tbody></table></div>`,'card-categories');
    html+=card('Panel',`<form id="panel-form" class="settings-form"><div class="settings-fields">${field('Panel-Name','name',d.panel?.name||'Standard Panel')}${field('Titel','title',d.panel?.title||'🎫 Support')}${field('Beschreibung','description',d.panel?.description||'Wähle eine Kategorie, um ein Ticket zu erstellen.')}${field('Farbe (Integer)','color',d.panel?.color||5793266,'number')}${field('Thumbnail','thumbnail',d.panel?.thumbnail||'')}${field('Banner','banner',d.panel?.banner||'')}${field('Footer','footer',d.panel?.footer||'Emergency Hamburg Roleplay')}</div><button class="btn primary">Panel speichern</button></form><form id="panel-send-form" class="question-add-form">${sel('Ziel-Channel','channel',textChannels,'','— Channel wählen —')}<button class="btn primary">Panel in Discord senden</button></form><div class="panel-preview"><div class="preview-label">Vorschau – Components V2</div><div class="dc-message"><div class="dc-avatar">EH</div><div class="dc-msg-main"><div class="dc-username">Emergency Hamburg Roleplay <span class="dc-app-badge">APP</span><span class="dc-time"></span></div><div id="dc-container" class="dc-container"></div></div></div></div>`);
    html+=ticketsHtml(d);
    html+=transcriptsHtml(d);
    html+=logHtml(d);
    root.innerHTML=html;
    document.dispatchEvent(new CustomEvent('ticket-dashboard-rendered'));
    document.getElementById('cat-form').onsubmit=async e=>{e.preventDefault();const fd=new FormData(e.currentTarget);const t={};fd.forEach((v,k)=>{t[k]=v;});['support_role_ids','admin_role_ids','ping_role_ids'].forEach(k=>{t[k]=fd.getAll(k).map(x=>String(x).trim()).filter(Boolean);});await guard(async()=>{await save('category_save',t);resetCatForm();await refresh();});};
    function resetCatForm(){const f=document.getElementById('cat-form');if(!f)return;f.reset();const h=f.querySelector('input[name=cat_id]');if(h)h.remove();f.removeAttribute('data-editing');const sub=document.getElementById('cat-submit-btn');if(sub)sub.textContent='Kategorie hinzufügen';const canc=document.getElementById('cat-cancel-btn');if(canc)canc.style.display='none';}
    document.getElementById('cat-cancel-btn')?.addEventListener('click',()=>resetCatForm());
    document.querySelectorAll('[data-edit-cat]').forEach(b=>b.onclick=()=>{try{const c=JSON.parse(b.dataset.editCat);const f=document.getElementById('cat-form');if(!f)return;resetCatForm();let h=f.querySelector('input[name=cat_id]');if(!h){h=document.createElement('input');h.type='hidden';h.name='cat_id';f.prepend(h);}h.value=c.id;f.setAttribute('data-editing',c.id);const set=(k,v)=>{const el=f.elements[k];if(el&&el.type!=='select-multiple')el.value=v;};set('name',c.name);set('description',c.description);set('emoji',c.emoji);set('ticket_limit',c.ticket_limit);set('prefix',c.prefix);set('color',c.color);set('category_channel_id',c.category_channel_id);['support_role_ids','admin_role_ids','ping_role_ids'].forEach(k=>{const el=f.elements[k];if(!el||el.type!=='select-multiple')return;const vals=JSON.parse(c[k]||'[]').map(String);Array.from(el.options).forEach(o=>{o.selected=vals.includes(o.value);});});const sub=document.getElementById('cat-submit-btn');if(sub)sub.textContent='Kategorie aktualisieren';const canc=document.getElementById('cat-cancel-btn');if(canc)canc.style.display='';f.scrollIntoView({behavior:'smooth',block:'center'});f.querySelector('[name=name]')?.focus();}catch(e){}});
    document.querySelectorAll('[data-del-cat]').forEach(b=>b.onclick=()=>guard(async()=>{await save('category_delete',{id:b.dataset.delCat});resetCatForm();await refresh();}));
    document.getElementById('panel-form').onsubmit=async e=>{e.preventDefault();await guard(async()=>{await save('panel_save',Object.fromEntries(new FormData(e.currentTarget).entries()));await refresh();});};
    lastPanel=d.panel||null;
    document.getElementById('panel-form').addEventListener('input',updatePreview);
    const timeEl=root.querySelector('.dc-time');
    if(timeEl)timeEl.textContent=`Heute um ${new Date().toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'})}`;
    updatePreview();
    document.getElementById('panel-send-form').onsubmit=async e=>{e.preventDefault();const fd=new FormData(e.currentTarget);const channel=fd.get('channel');if(!channel)return;await guard(async()=>{await save('panel_send',{channel_id:channel});await refresh();});};
  }
  function overviewHtml(d){const st=d.stats||{};const metrics=[['Offen',st.open||0],['Geschlossen',st.closed||0],['Heute',st.today||0],['Diese Woche',st.week||0],['Dieser Monat',st.month||0]];return card('Übersicht',`<div class="stats-grid">${metrics.map(x=>`<div class="stat-card"><div class="stat-value">${x[1]}</div><div class="stat-label">${x[0]}</div></div>`).join('')}</div><div class="table-wrap"><table class="data-table"><thead><tr><th>Meistgenutzte Kategorie</th><th>Aktivster Supporter</th><th>Tickets pro Mitarbeiter</th></tr></thead><tbody><tr><td>${esc(d.categories?.find(c=>String(c.id)===String(st.mostCategoryId))?.name||'—')}</td><td>${st.activeSupporterId?`<@${esc(st.activeSupporterId)}>`:'—'}</td><td>${Object.entries(st.ticketsPerEmployee||{}).map(([u,n])=>`<div><code>${esc(u)}</code> — ${n}</div>`).join('')||'—'}</td></tr></tbody></table></div>`,'card-overview');}
  function ticketsHtml(d){return card('Tickets',`<div class="table-wrap"><table class="data-table"><thead><tr><th>ID</th><th>Nummer</th><th>Owner</th><th>Status</th><th>Kategorie</th><th>Bearbeiter</th></tr></thead><tbody>${(d.tickets||[]).map(t=>`<tr><td>${t.id}</td><td>${t.ticket_number||'—'}</td><td>${esc(t.owner_id)}</td><td>${esc(t.status)}</td><td>${esc(d.categories?.find(c=>String(c.id)===String(t.category_id))?.name||t.category_id||'—')}</td><td>${esc(t.assigned_user_id||'—')}</td></tr>`).join('')||'<tr><td colspan="6">Keine Tickets</td></tr>'}</tbody></table></div>`,'card-tickets');}
  function transcriptsHtml(d){return card('Transcripts',`<div class="table-wrap"><table class="data-table"><thead><tr><th>Ticket</th><th>Typ</th><th>Nachrichten</th><th>Erstellt</th><th>Aktion</th></tr></thead><tbody>${(d.transcripts||[]).map(t=>`<tr><td>${t.ticket_id}</td><td>${esc(t.transcript_type||'html')}</td><td>${t.message_count||0}</td><td>${t.created_at?new Date(t.created_at).toLocaleString('de-DE'):'—'}</td><td><a href="/api/settings/transcript/${t.id}?guild=${encodeURIComponent(guildId)}" target="_blank">Ansehen</a></td></tr>`).join('')||'<tr><td colspan="5">Keine Transcripts</td></tr>'}</tbody></table></div>`,'card-transcripts');}
  function logHtml(d){return card('Ticket-Log',`<div class="table-wrap"><table class="data-table"><thead><tr><th>Event</th><th>Ticket</th><th>Actor</th><th>Zeit</th></tr></thead><tbody>${(d.events||[]).map(e=>`<tr><td>${esc(e.event)}</td><td>${e.ticket_id||'—'}</td><td>${esc(e.actor_tag||e.actor_id||'System')}</td><td>${e.created_at?new Date(e.created_at).toLocaleString('de-DE'):'—'}</td></tr>`).join('')||'<tr><td colspan="4">Keine Events</td></tr>'}</tbody></table></div>`,'card-log');}
  function updateLive(d){[['card-overview',overviewHtml],['card-tickets',ticketsHtml],['card-transcripts',transcriptsHtml],['card-log',logHtml]].forEach(([id,fn])=>{const el=document.getElementById(id);if(el)el.outerHTML=fn(d);});}
  async function refresh(tries){tries=tries===undefined?2:tries;root.innerHTML='<div class="empty-state"><p>Ticket-Daten werden geladen …</p></div>';try{render(await load())}catch(e){if(tries>0){root.innerHTML='<div class="empty-state"><p>Verbindung langsam – neuer Versuch …</p></div>';await new Promise(r=>setTimeout(r,4000));return refresh(tries-1);}root.innerHTML='<div class="alert error">Ticket-Dashboard konnte nicht geladen werden: '+esc(e.message)+'</div>';}}
  (async()=>{await refresh();setInterval(async()=>{if(busy||document.visibilityState!=='visible')return;try{updateLive(await load());}catch(e){}},10000);})();
})();
</script>
