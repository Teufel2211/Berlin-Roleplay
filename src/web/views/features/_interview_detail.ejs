<h2 class="feature-title">Interview-Detail</h2>
<p class="muted">
  <a href="/dashboard/servers/<%= guildId %>/feature/interview">← Zurück zur Übersicht</a>
</p>
<%
  var row = data.detail.row;
  var questions = data.detail.questions;
  var scores = row.scores || {};
  var maxPoints = questions.length * 2;
%>
<div class="stat-grid">
  <div class="stat-card"><div class="stat-value"><%= row.total != null ? Number(row.total).toLocaleString('de-DE') : '—' %></div><div class="stat-label">Punkte</div></div>
  <div class="stat-card"><div class="stat-value"><%= maxPoints %></div><div class="stat-label">Max</div></div>
  <div class="stat-card"><div class="stat-value"><% if (row.passed === true) { %>✅<% } else if (row.passed === false) { %>❌<% } else { %>…<% } %></div><div class="stat-label"><%= row.passed === true ? 'Bestanden' : row.passed === false ? 'Nicht bestanden' : 'Offen' %></div></div>
</div>
<div class="bot-status"><span class="status-dot <%= row.status === 'fertig' ? 'online' : 'offline' %>"></span> Status: <%= row.status %></div>

<h3 class="list-title"><strong><%= row.applicant_name || row.applicant_id %></strong> — <%= new Date(row.created_at).toLocaleString('de-DE') %></h3>
<% if (row.application_id) { %><div class="bot-status"><span class="status-dot online"></span> Verknüpfte Bewerbung: <span class="code">#<%= row.application_id %></span></div><% } %>
<div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>#</th><th>Abschnitt</th><th>Frage</th><th>Punktzahl</th></tr></thead>
    <tbody>
      <% questions.forEach(function (q, i) { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= q.section %></td>
        <td><%= q.frage %></td>
        <td><%= scores[q.id] !== undefined ? Number(scores[q.id]).toLocaleString('de-DE') : '—' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
