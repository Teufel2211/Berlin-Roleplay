<h2 class="feature-title"><%= feature.name %></h2>
<% if (data.flash) { %><div class="alert"><%= data.flash %></div><% } %>
<% if (feature.id === 'team') { %>
  <p class="muted">Zentrale Teamverwaltung mit Rängen, Abteilungen, Mitgliedern und Verknüpfung zu Bewerbungen und Interviews.</p>
  <div class="stat-grid">
    <div class="stat-card"><div class="stat-value"><%= data.members.length %></div><div class="stat-label">Teammitglieder</div></div>
    <div class="stat-card"><div class="stat-value"><%= data.ranks.length %></div><div class="stat-label">Ränge</div></div>
    <div class="stat-card"><div class="stat-value"><%= data.departments.length %></div><div class="stat-label">Abteilungen</div></div>
    <div class="stat-card"><div class="stat-value"><%= data.absences.length %></div><div class="stat-label">Abwesenheiten</div></div>
  </div>
  <h3 class="list-title">Teammitglied hinzufügen</h3>
  <form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action" class="question-add-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add_member">
    <input type="text" name="discord_id" placeholder="Discord-ID" required>
    <select name="rank_id"><option value="">Rang auswählen</option><% data.ranks.forEach(function(r){ %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select>
    <select name="department_id"><option value="">Abteilung auswählen</option><% data.departments.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select>
    <button class="btn primary">Hinzufügen</button>
  </form>
  <h3 class="list-title">Team-Liste</h3>
  <div class="table-wrap"><table class="data-table"><thead><tr><th>Mitglied</th><th>Rang</th><th>Abteilung</th><th>Status</th><th></th></tr></thead><tbody>
  <% data.members.forEach(function(m){ var rank=data.ranks.find(function(r){return r.id===m.rank_id}); var dep=data.departments.find(function(d){return d.id===m.department_id}); %>
    <tr><td><strong><%= m.discord_id %></strong></td><td><%= rank ? rank.name : '—' %></td><td><%= dep ? dep.name : '—' %></td><td><span class="badge <%= m.status %>"><%= m.status %></span></td><td><form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="remove_member"><input type="hidden" name="discord_id" value="<%= m.discord_id %>"><button class="btn small danger">Entfernen</button></form></td></tr>
  <% }) %></tbody></table></div>
  <h3 class="list-title">Abteilungen</h3>
  <form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action" class="question-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add_department"><input name="name" placeholder="Abteilungsname" required><input name="description" placeholder="Beschreibung"><button class="btn">Abteilung hinzufügen</button></form>
  <h3 class="list-title">Ränge</h3>
  <form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action" class="question-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add_rank"><input name="name" placeholder="Rangname" required><input name="discord_role_id" placeholder="Discord Rollen-ID"><select name="department_id"><option value="">Keine Abteilung</option><% data.departments.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select><button class="btn">Rang hinzufügen</button></form>
<% } else if (feature.id === 'calendar') { %>
  <p class="muted">Team-Kalender für Meetings, Ausbildungen, Interviews und weitere Termine.</p>
  <form method="post" action="/dashboard/servers/<%= guildId %>/feature/calendar/action" class="question-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add_event"><input name="title" placeholder="Titel" required><input name="starts_at" type="datetime-local" required><input name="ends_at" type="datetime-local"><input name="location" placeholder="Ort/Kanal"><input name="description" placeholder="Beschreibung"><button class="btn primary">Termin hinzufügen</button></form>
  <div class="table-wrap"><table class="data-table"><thead><tr><th>Termin</th><th>Beginn</th><th>Ende</th><th>Ort</th></tr></thead><tbody><% data.events.forEach(function(e){ %><tr><td><strong><%= e.title %></strong><div class="muted"><%= e.description || '' %></div></td><td><%= new Date(e.starts_at).toLocaleString('de-DE') %></td><td><%= e.ends_at ? new Date(e.ends_at).toLocaleString('de-DE') : '—' %></td><td><%= e.location || '—' %></td></tr><% }) %></tbody></table></div>
<% } else if (feature.id === 'moderation') { %>
  <p class="muted">Moderationsfälle und Verwarnungshistorie.</p>
  <div class="table-wrap"><table class="data-table"><thead><tr><th>Aktion</th><th>Ziel</th><th>Moderator</th><th>Grund</th><th>Datum</th></tr></thead><tbody><% data.cases.forEach(function(c){ %><tr><td><strong><%= c.action %></strong></td><td><%= c.target_id %></td><td><%= c.moderator_id %></td><td><%= c.reason || '—' %></td><td><%= new Date(c.created_at).toLocaleString('de-DE') %></td></tr><% }) %></tbody></table></div>
<% } else if (feature.id === 'welcome') { %>
  <p class="muted">Willkommensnachrichten, automatische Rollen und DM-Begrüßung.</p>
  <form method="post" action="/dashboard/servers/<%= guildId %>/feature/welcome/action" class="question-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="save"><select name="channel_id"><option value="">Kanal auswählen</option><% (data.channelOptions || []).forEach(function(c){ %><option value="<%= c.id %>" <%= data.config && data.config.channel_id===c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select><input name="title" placeholder="Titel" value="<%= data.config && data.config.embed_data ? (data.config.embed_data.title || 'Willkommen!') : 'Willkommen!' %>"><input name="description" placeholder="Beschreibung" value="<%= data.config && data.config.embed_data ? (data.config.embed_data.description || '') : '' %>"><input name="color" placeholder="#2B3A67" value="<%= data.config && data.config.embed_data ? (data.config.embed_data.color || '#2B3A67') : '#2B3A67' %>"><label><input type="checkbox" name="dm_enabled" value="true" <%= data.config && data.config.dm_enabled ? 'checked' : '' %>> DM senden</label><button class="btn primary">Speichern</button></form>
  <h3 class="list-title">Automatische Rollen</h3><div class="role-list"><% (data.roleOptions || []).forEach(function(r){ %><label><input type="checkbox" form="welcome-form" name="auto_role_ids" value="<%= r.id %>"><%= r.name %></label><% }) %></div>
<% } else { %>
  <p class="muted">Modul bereit. Die Konfiguration wird über das Dashboard verwaltet.</p>
<% } %>
