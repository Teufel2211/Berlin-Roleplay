<h2 class="feature-title"><%= feature.name %></h2>
<% if (data.flash) { %><div class="alert"><%= data.flash %></div><% } %>
<% if (feature.id === 'team') { %>
  <p class="muted">Zentrale Teamverwaltung mit Rängen, Abteilungen, Mitgliedern, Beförderungen und Abwesenheiten.</p>
  <div class="feature-section" id="sec-mitglieder">
    <div class="stat-grid"><div class="stat-card"><div class="stat-value"><%= data.members.length %></div><div class="stat-label">Teammitglieder</div></div><div class="stat-card"><div class="stat-value"><%= data.ranks.length %></div><div class="stat-label">Ränge</div></div><div class="stat-card"><div class="stat-value"><%= data.departments.length %></div><div class="stat-label">Abteilungen</div></div><div class="stat-card"><div class="stat-value"><%= data.absences.length %></div><div class="stat-label">Abwesenheiten</div></div></div>
    <h3 class="list-title">Teammitglied hinzufügen</h3>
    <form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action" class="question-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add_member"><input type="text" name="discord_id" placeholder="Discord-ID" required><select name="rank_id"><option value="">Rang auswählen</option><% data.ranks.forEach(function(r){ %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select><select name="department_id"><option value="">Abteilung auswählen</option><% data.departments.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select><button class="btn primary">Hinzufügen</button></form>
    <h3 class="list-title">Beförderung / Versetzung</h3>
    <form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action" class="question-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="promote"><select name="discord_id" required><option value="">Teammitglied auswählen</option><% data.members.forEach(function(m){ %><option value="<%= m.discord_id %>"><%= m.discord_id %></option><% }) %></select><select name="rank_id" required><option value="">Neuer Rang</option><% data.ranks.forEach(function(r){ %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select><select name="department_id"><option value="">Abteilung unverändert</option><% data.departments.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select><button class="btn primary">Ändern</button></form>
    <h3 class="list-title">Team-Liste</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>Mitglied</th><th>Rang</th><th>Abteilung</th><th>Status</th><th></th></tr></thead><tbody><% data.members.forEach(function(m){ var rank=data.ranks.find(function(r){return r.id===m.rank_id}); var dep=data.departments.find(function(d){return d.id===m.department_id}); %><tr><td><strong><%= m.discord_id %></strong></td><td><%= rank ? rank.name : '—' %></td><td><%= dep ? dep.name : '—' %></td><td><span class="badge <%= m.status %>"><%= m.status %></span></td><td><form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="remove_member"><input type="hidden" name="discord_id" value="<%= m.discord_id %>"><button class="btn small danger">Entfernen</button></form></td></tr><% }) %></tbody></table></div>
  </div>
  <div class="feature-section" id="sec-abteilungen">
    <h3 class="list-title">Abteilung hinzufügen</h3><form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action" class="question-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add_department"><input name="name" placeholder="Abteilungsname" required><input name="description" placeholder="Beschreibung"><button class="btn">Abteilung hinzufügen</button></form>
    <% if (data.departments.length) { %><div class="table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>Beschreibung</th></tr></thead><tbody><% data.departments.forEach(function(d){ %><tr><td><strong><%= d.name %></strong></td><td><%= d.description || '—' %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><p>Noch keine Abteilungen angelegt.</p></div><% } %>
  </div>
  <div class="feature-section" id="sec-raenge">
    <h3 class="list-title">Rang hinzufügen</h3><form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action" class="question-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add_rank"><input name="name" placeholder="Rangname" required><input name="discord_role_id" placeholder="Discord Rollen-ID"><select name="department_id"><option value="">Keine Abteilung</option><% data.departments.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select><button class="btn">Rang hinzufügen</button></form>
    <% if (data.ranks.length) { %><div class="table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>Abteilung</th><th>Rollen-ID</th></tr></thead><tbody><% data.ranks.forEach(function(r){ var dep=data.departments.find(function(d){return d.id===r.department_id}); %><tr><td><strong><%= r.name %></strong></td><td><%= dep ? dep.name : '—' %></td><td><span class="code"><%= r.discord_role_id || '—' %></span></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><p>Noch keine Ränge angelegt.</p></div><% } %>
  </div>
  <div class="feature-section" id="sec-abwesenheiten">
    <h3 class="list-title">Abwesenheit eintragen</h3>
    <form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action" class="question-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add_absence"><select name="discord_id" required><option value="">Teammitglied</option><% data.members.forEach(function(m){ %><option value="<%= m.discord_id %>"><%= m.discord_id %></option><% }) %></select><input name="starts_at" type="datetime-local" required><input name="ends_at" type="datetime-local" required><input name="reason" placeholder="Grund"><button class="btn">Abwesenheit eintragen</button></form>
    <% if (data.absences.length) { %><div class="table-wrap"><table class="data-table"><thead><tr><th>Mitglied</th><th>Von</th><th>Bis</th><th>Grund</th></tr></thead><tbody><% data.absences.forEach(function(a){ %><tr><td><%= a.discord_id %></td><td><%= new Date(a.starts_at).toLocaleString('de-DE') %></td><td><%= new Date(a.ends_at).toLocaleString('de-DE') %></td><td><%= a.reason || '—' %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><p>Keine Abwesenheiten eingetragen.</p></div><% } %>
  </div>
  <div class="feature-section" id="sec-termine">
    <h3 class="list-title">Termin hinzufügen</h3>
    <form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action" class="question-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add_event"><input name="title" placeholder="Titel" required><input name="starts_at" type="datetime-local" required><input name="ends_at" type="datetime-local"><input name="location" placeholder="Ort/Kanal"><input name="description" placeholder="Beschreibung"><button class="btn primary">Termin hinzufügen</button></form>
    <% if (data.events.length) { %><div class="table-wrap"><table class="data-table"><thead><tr><th>Termin</th><th>Beginn</th><th>Ende</th><th>Ort</th><th></th></tr></thead><tbody><% data.events.forEach(function(e){ %><tr><td><strong><%= e.title %></strong><div class="muted"><%= e.description || '' %></div></td><td><%= new Date(e.starts_at).toLocaleString('de-DE') %></td><td><%= e.ends_at ? new Date(e.ends_at).toLocaleString('de-DE') : '—' %></td><td><%= e.location || '—' %></td><td><form method="post" action="/dashboard/servers/<%= guildId %>/feature/team/action"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="delete_event"><input type="hidden" name="id" value="<%= e.id %>"><button class="btn small danger">Löschen</button></form></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><p>Keine Termine eingetragen.</p></div><% } %>
  </div>
  <%- include('../partials/_sec_settings', { sectionId: 'protokoll', data, featureId: 'team', guildId }) %>
<% } else if (feature.id === 'moderation') { %>
  <p class="muted">Moderationsfälle und Verwarnungshistorie.</p>
  <div class="feature-section" id="sec-faelle">
    <div class="table-wrap"><table class="data-table"><thead><tr><th>Aktion</th><th>Ziel</th><th>Moderator</th><th>Grund</th><th>Datum</th></tr></thead><tbody><% data.cases.forEach(function(c){ %><tr><td><strong><%= c.action %></strong></td><td><%= c.target_id %></td><td><%= c.moderator_id %></td><td><%= c.reason || '—' %></td><td><%= new Date(c.created_at).toLocaleString('de-DE') %></td></tr><% }) %></tbody></table></div>
  </div>
  <%- include('../partials/_sec_settings', { sectionId: 'panel', data, featureId: 'moderation', guildId }) %>
  <%- include('../partials/_sec_settings', { sectionId: 'protokoll', data, featureId: 'moderation', guildId }) %>
<% } else if (feature.id === 'welcome') { %>
  <p class="muted">Willkommens-Embed mit Live-Vorschau, automatischen Rollen und optionaler DM-Begrüßung.</p>
  <div class="feature-section" id="sec-willkommen">
    <form method="post" action="/dashboard/servers/<%= guildId %>/feature/welcome/action" class="embed-form" id="welcome-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="action" value="save">
      <input type="hidden" name="enabled" value="true">
      <div class="embed-editor">
        <div class="embed-fields-col">
          <div class="settings-fields">
            <label class="field"><span class="field-label">Willkommens-Kanal</span><select name="channel_id"><option value="">— Kanal wählen —</option><% (data.channelOptions || []).forEach(function(c){ %><option value="<%= c.id %>" <%= data.config && data.config.channel_id===c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></label>
            <label class="field"><span class="field-label">Titel</span><input name="title" value="<%= data.config && data.config.embed_data ? (data.config.embed_data.title || 'Willkommen!') : 'Willkommen!' %>" placeholder="Willkommen!"></label>
            <label class="field"><span class="field-label">Beschreibung</span><textarea name="description" rows="5" placeholder="Willkommen auf {server}, {user}!"><%= data.config && data.config.embed_data ? (data.config.embed_data.description || '') : '' %></textarea></label>
            <label class="field"><span class="field-label">Farbe</span><div class="color-row"><input type="color" id="welcome-color" value="<%= data.config && data.config.embed_data && /^#[0-9a-fA-F]{6}$/.test(data.config.embed_data.color || '') ? data.config.embed_data.color : '#2B3A67' %>"><input type="text" name="color" id="welcome-color-text" value="<%= data.config && data.config.embed_data ? (data.config.embed_data.color || '#2B3A67') : '#2B3A67' %>" placeholder="#2B3A67"></div></label>
            <label class="field"><span class="field-label">Bild-URL</span><input name="image" value="<%= data.config && data.config.embed_data ? (data.config.embed_data.image || '') : '' %>" placeholder="https://…"></label>
            <label class="field"><span class="field-label">Thumbnail-URL</span><input name="thumbnail" value="<%= data.config && data.config.embed_data ? (data.config.embed_data.thumbnail || '') : '' %>" placeholder="https://…"></label>
            <label class="field"><span class="field-label">Variablen</span><span class="muted"><code>{user}</code> <code>{username}</code> <code>{server}</code> <code>{member_count}</code> <code>{join_date}</code> <code>{user_count}</code> <code>{bot_count}</code></span></label>
          </div>

          <h3 class="list-title">Embed-Felder</h3>
          <div id="welcome-fields" class="dynamic-rows">
            <% ((data.config && data.config.embed_data && Array.isArray(data.config.embed_data.fields)) ? data.config.embed_data.fields : []).forEach(function(f){ %>
            <div class="dynamic-row welcome-field-row">
              <input name="field_name[]" placeholder="Feldname" value="<%= f.name || '' %>">
              <input name="field_value[]" placeholder="Wert" value="<%= f.value || '' %>">
              <label class="inline-check"><input type="checkbox" name="field_inline[]" value="true" <%= f.inline ? 'checked' : '' %>>Inline</label>
              <button type="button" class="btn small remove-row">✕</button>
            </div>
            <% }) %>
          </div>
          <button type="button" class="btn small" id="welcome-field-add">+ Feld</button>

          <h3 class="list-title">Verhalten</h3>
          <div class="settings-fields">
            <label class="field checkbox-field"><input type="checkbox" name="dm_enabled" value="true" <%= data.config && data.config.dm_enabled ? 'checked' : '' %>><span>Willkommens-DM senden</span></label>
            <label class="field checkbox-field"><input type="checkbox" name="enabled" value="true" checked><span>Willkommenssystem aktiv</span></label>
          </div>

          <h3 class="list-title">Automatische Rollen</h3>
          <div class="role-list"><% (data.roleOptions || []).forEach(function(r){ var selected=data.config && Array.isArray(data.config.auto_role_ids) && data.config.auto_role_ids.indexOf(r.id)!==-1; %><label><input type="checkbox" name="auto_role_ids" value="<%= r.id %>" <%= selected ? 'checked' : '' %>><%= r.name %></label><% }) %></div>

          <div class="embed-actions"><button type="submit" class="btn primary">Willkommenssystem speichern</button></div>
        </div>

        <div class="embed-preview-col">
          <h3 class="list-title">Live-Vorschau</h3>
          <div class="embed-preview" id="welcomePreview"></div>
        </div>
      </div>
    </form>
  </div>
  <script>
  (function () {
    var form = document.getElementById('welcome-form');
    var preview = document.getElementById('welcomePreview');
    var fieldWrap = document.getElementById('welcome-fields');
    var addField = document.getElementById('welcome-field-add');
    var color = document.getElementById('welcome-color');
    var colorText = document.getElementById('welcome-color-text');
    if (!form || !preview) return;
    function esc(s) { var d=document.createElement('div'); d.textContent=s==null?'':String(s); return d.innerHTML; }
    function val(name) { var el=form.querySelector('[name="'+name+'"]'); return el ? el.value : ''; }
    function checked(name) { var el=form.querySelector('[name="'+name+'"]'); return Boolean(el && el.checked); }
    function colorValue() { var v=(colorText.value||color.value||'#2B3A67').trim().replace(/^#/,''); return /^[0-9a-fA-F]{6}$/.test(v) ? '#'+v : '#2B3A67'; }
    function fields() { return Array.prototype.slice.call(form.querySelectorAll('#welcome-fields .dynamic-row')).map(function(row){ return { name: row.querySelector('[name="field_name[]"]').value, value: row.querySelector('[name="field_value[]"]').value, inline: row.querySelector('[name="field_inline[]"]').checked }; }); }
    function render() {
      var c=colorValue(), title=val('title') || 'Willkommen!', desc=val('description') || 'Willkommen auf {server}, {user}!', fieldsData=fields().filter(function(f){return f.name||f.value;});
      var html='<div class="ep-bar" style="background:'+c+'"></div><div class="ep-content"><div class="ep-author">Emergency Hamburg Roleplay</div>';
      html+='<div class="ep-title">'+esc(title)+'</div><div class="ep-desc">'+esc(desc).replace(/\n/g,'<br>')+'</div>';
      if(fieldsData.length){html+='<div class="ep-fields">';fieldsData.forEach(function(f){html+='<div class="ep-field'+(f.inline?' inline':'')+'"><div class="ep-field-name">'+esc(f.name||' ')+'</div><div class="ep-field-value">'+esc(f.value||' ').replace(/\n/g,'<br>')+'</div></div>';});html+='</div>';}
      var image=val('image'), thumbnail=val('thumbnail');
      if(image) html+='<div class="ep-image"><img src="'+esc(image)+'" alt="" onerror="this.style.display=\'none\'"></div>';
      if(thumbnail) html+='<div class="ep-thumb"><img src="'+esc(thumbnail)+'" alt="" onerror="this.style.display=\'none\'"></div>';
      html+='<div class="ep-footer">Heute um 20:40 Uhr</div></div>';
      preview.innerHTML=html;
    }
    form.addEventListener('input', render); form.addEventListener('change', render);
    if(color){color.addEventListener('input',function(){colorText.value=color.value;render();});}
    if(colorText){colorText.addEventListener('input',function(){var v=colorText.value.replace(/^#/,'');if(/^[0-9a-fA-F]{6}$/.test(v)&&color)color.value='#'+v;render();});}
    if(addField){addField.addEventListener('click',function(){var row=document.createElement('div');row.className='dynamic-row welcome-field-row';row.innerHTML='<input name="field_name[]" placeholder="Feldname"><input name="field_value[]" placeholder="Wert"><label class="inline-check"><input type="checkbox" name="field_inline[]" value="true">Inline</label><button type="button" class="btn small remove-row">✕</button>';fieldWrap.appendChild(row);render();});}
    form.addEventListener('click',function(e){if(e.target.classList.contains('remove-row')){var row=e.target.closest('.dynamic-row');if(row)row.remove();render();}});
    render();
  })();
  </script>
<% } else if (feature.id === 'security') { %>
  <p class="muted">Sicherheitsübersicht und Moderationsaktivität.</p>
  <div class="feature-section" id="sec-uebersicht">
    <div class="stat-grid"><div class="stat-card"><div class="stat-value"><%= data.cases.length %></div><div class="stat-label">Moderationsfälle</div></div></div>
  </div>
<% } %>
