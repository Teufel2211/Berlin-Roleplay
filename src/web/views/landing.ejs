<%- include('partials/head', { title, user, csrf }) %>
<section class="landing">
  <div class="landing-hero">
    <span class="landing-eyebrow"><span class="dot"></span>Bot online · Dashboard aktiv</span>
    <h1>Emergency Hamburg Roleplay</h1>
    <p class="muted">Der zentrale Bot für deinen Server: Verifizierung, Warteraum, Counting, Giveaways, Tickets, Bewerbungen, Interviews und mehr.</p>
    <% if (loggedIn) { %>
    <a href="/dashboard" class="discord-btn">Zum Dashboard</a>
    <% } else { %>
    <a href="/dashboard/login" class="discord-btn">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
      Mit Discord anmelden
    </a>
    <% } %>
  </div>
  <div class="landing-features">
    <ul class="feature-list" id="featureList">
      <li data-feature="verification" class="active"><span class="feature-icon">✅</span><span class="feature-item-name">Verifizierung</span></li>
      <li data-feature="warteraum"><span class="feature-icon">🎧</span><span class="feature-item-name">Warteraum</span></li>
      <li data-feature="counting"><span class="feature-icon">🔢</span><span class="feature-item-name">Counting</span></li>
      <li data-feature="giveaway"><span class="feature-icon">🎉</span><span class="feature-item-name">Giveaway</span></li>
      <li data-feature="tickets"><span class="feature-icon">🎫</span><span class="feature-item-name">Tickets</span></li>
      <li data-feature="bewerbung"><span class="feature-icon">📝</span><span class="feature-item-name">Bewerbung</span></li>
      <li data-feature="interview"><span class="feature-icon">🎤</span><span class="feature-item-name">Interview</span></li>
      <li data-feature="embeds"><span class="feature-icon">🖼️</span><span class="feature-item-name">Embed-Builder</span></li>
      <li data-feature="audit"><span class="feature-icon">🛡️</span><span class="feature-item-name">Audit-Log</span></li>
    </ul>
    <div class="feature-detail" id="featureDetail">
      <h2 id="detailTitle">Verifizierung</h2>
      <p id="detailText">Nutzer verifizieren sich per Button-Panel. Beim Verifizieren wird die konfigurierte Rolle vergeben und das Verhalten über Einstellungen gesteuert.</p>
    </div>
  </div>
</section>
<script>
  (function () {
    var list = document.getElementById('featureList');
    var title = document.getElementById('detailTitle');
    var text = document.getElementById('detailText');
    var desc = {
      verification: 'Nutzer verifizieren sich per Button-Panel. Beim Verifizieren wird die konfigurierte Rolle vergeben und das Verhalten über Einstellungen gesteuert.',
      warteraum: 'Sobald ein Nutzer den Warteraum-Voice betritt, wird er automatisch in den Ziel-Kanal umgeleitet und bekommt die Warteraum-Rolle.',
      counting: 'Zähl-Channel mit fortlaufender Zahl, optionalen Dezimalzahlen und Meilensteinen. Falsche Zahlen starten den Countdown neu.',
      giveaway: 'Gewinnspiele mit Button-Teilnahme, konfigurierbaren Gewinnern und optionalen Pflicht-Rollen.',
      tickets: 'Support-Tickets über ein Panel. Tickets können übernommen, geschlossen und als Transkript archiviert werden.',
      bewerbung: 'Bewerbungen werden über ein Modal eingereicht und von Staff/Admin entschieden (Angenommen/Abgelehnt).',
      interview: 'Strukturierte Interview-Bewertung direkt im Discord-Chat: Fragen in Abschnitten, Bewertung pro Frage, automatisierte Bestanden-Prüfung.',
      embeds: 'Erstelle und verwalte Discord-Embeds im Dashboard, inklusive Live-Vorschau, Feldern, Buttons und Farben.',
      audit: 'Alle Änderungen und Aktionen werden pro Server protokolliert und sind hier einsehbar.'
    };
    list.addEventListener('click', function (e) {
      var li = e.target.closest('li');
      if (!li) return;
      var feat = li.getAttribute('data-feature');
      var name = li.querySelector('.feature-item-name');
      var items = list.querySelectorAll('li');
      for (var i = 0; i < items.length; i++) items[i].classList.remove('active');
      li.classList.add('active');
      title.textContent = name ? name.textContent.trim() : li.textContent.trim();
      text.textContent = desc[feat] || '';
    });
  })();
</script>
<%- include('partials/foot') %>
