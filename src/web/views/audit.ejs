<%- include('partials/head', { title, user, csrf }) %>
<h1>Audit-Log</h1>
<% if (locals.dbError) { %><div class="alert error"><%= dbError %></div><% } %>
<% if (entries.length === 0) { %><p class="hint">Noch keine Einträge.</p><% } %>
<table>
  <thead><tr><th>Zeit</th><th>Akteur</th><th>Aktion</th><th>Details</th></tr></thead>
  <tbody>
    <% entries.forEach((e) => {
      const detail = e.detail ? JSON.stringify(e.detail) : '';
    %>
    <tr>
      <td class="nowrap"><%= new Date(e.created_at).toLocaleString('de-DE') %></td>
      <td><%= e.actor %></td>
      <td><code><%= e.action %></code></td>
      <td class="mono"><%= detail %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/foot') %>
