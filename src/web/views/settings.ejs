<%- include('partials/head', { title, user, csrf }) %>
<% if (locals.locked) { %>
<div class="code-box">
  <h2>Mit Code einloggen</h2>
  <p class="muted">Ein einmaliger Code wurde dir als Discord-Nachricht geschickt (10 Min. gültig, nur 1× verwendbar).</p>
  <% if (locals.codeSent === false) { %><p class="alert error">Der Code konnte nicht gesendet werden (Bot offline oder keine DM möglich).</p><% } %>
  <% if (locals.codeError) { %><p class="alert error">Code ungültig, abgelaufen oder bereits benutzt.</p><% } %>
  <form method="post" action="/dashboard/settings/unlock">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="password" name="code" inputmode="numeric" maxlength="6" pattern="[0-9]*" required autofocus placeholder="·······">
    <button type="submit" class="primary">Freischalten</button>
  </form>
  <form method="post" action="/dashboard/settings/code" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button type="submit" class="btn-secondary">Neuen Code anfordern</button>
  </form>
</div>
<% } else { %>
<h1>Einstellungen</h1>
<p class="hint">Rollen und Kanäle wählst du direkt aus einer Liste aus (live aus Discord geladen). Unter „Sicherheit" kannst du den Admin-Schutz einschalten (Code eintragen + speichern): Danach ist die Seite gesperrt und du erhältst bei jedem Aufruf einen einmaligen Code per Discord-Nachricht.</p>
<form method="post" action="/dashboard/settings">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% groups.forEach((g) => { %>
  <h2><%= g.group %></h2>
  <div class="setting-group">
    <% g.fields.forEach((f) => { %>
    <label class="setting-row">
      <span><%= f.label %></span>
      <% if (f.boolean) { %>
        <input type="hidden" name="settings[<%= f.key %>]" value="false">
        <input type="checkbox" name="settings[<%= f.key %>]" value="true" <%= f.value === 'true' ? 'checked' : '' %>>
      <% } else if (f.key === 'application_questions') { %>
        <textarea name="settings[<%= f.key %>]" rows="4"><%= f.value %></textarea>
      <% } else if (f.type === 'channel' && locals.channelOptions) { %>
        <select name="settings[<%= f.key %>]">
          <option value="">— nicht gesetzt —</option>
          <% channelOptions.forEach((o) => { %>
          <option value="<%= o.id %>" <%= f.value === o.id ? 'selected' : '' %>><%= o.label %></option>
          <% }) %>
        </select>
      <% } else if (f.type === 'role' && locals.roleOptions) { %>
        <select name="settings[<%= f.key %>]">
          <option value="">— nicht gesetzt —</option>
          <% roleOptions.forEach((o) => { %>
          <option value="<%= o.name %>" <%= f.value === o.name ? 'selected' : '' %>><%= o.name %></option>
          <% }) %>
        </select>
      <% } else { %>
        <input type="text" name="settings[<%= f.key %>]" value="<%= f.value %>">
      <% } %>
    </label>
    <% }) %>
  </div>
  <% }) %>
  <button type="submit" class="primary">Speichern</button>
</form>
<% } %>
<%- include('partials/foot') %>
