<%- include('partials/head', { title, user, csrf }) %>
<h1>Bewerbungen</h1>
<% if (locals.dbError) { %><div class="alert error"><%= dbError %></div><% } %>
<% if (applications.length === 0) { %><p class="hint">Noch keine Bewerbungen.</p><% } %>
<% applications.forEach((a) => { %>
<div class="app-card">
  <h3>#<%= a.id %> — <%= a.type %> <span class="status status-<%= a.status %>"><%= a.status %></span></h3>
  <p class="dim">Bewerber: <%= a.discord_id %> · <%= new Date(a.created_at).toLocaleString('de-DE') %></p>
  <pre class="answers"><%= JSON.stringify(a.answers, null, 2) %></pre>
</div>
<% }) %>
<%- include('partials/foot') %>
